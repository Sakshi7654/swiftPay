{
  "extends": "@repo/typescript-config/base.json",
  "compilerOptions": {
    // "outDir": "dist",
    "rootDir": "./src",
    "outDir": "./dist",
    "strictNullChecks": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2023",
    "strict": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0"
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}
