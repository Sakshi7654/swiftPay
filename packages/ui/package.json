{
  "name": "@repo/ui",
  "version": "0.0.0",
  "private": true,
  "exports": {
    "./styles.css": "./dist/styles.css",
    "./*": "./src/*.tsx",
    "./appbar": "./src/Appbar.tsx",
    "./card": "./src/card.tsx"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "generate:component": "turbo gen react-component",
    "check-types": "tsc --noEmit",
    "build:css": "tailwindcss -i ./styles.css -o ./dist/styles.css --minify",
    "build": "npm run build:css && tsc", 
    "dev": "npx @tailwindcss/cli -i ./styles.css -o ./dist/styles.css --watch"
  },
  "devDependencies": {
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^22.15.3",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "^9.39.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.0.0",
    "typescript": "5.9.2"
  },
  "files": [
    "styles.css"
  ],
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}
